{
 "file": "LOW41.TLK",
 "kind": "script",
 "items": [
  {
   "id": 0,
   "ko": "얀도르 웅에르트"
  },
  {
   "id": 1,
   "ko": "<물건 사러 왔어요, 수다 떨러 왔어요?>"
  },
  {
   "id": 2,
   "ko": "<뭘 사시려는 거예요, 아니면 수다 떨러 오셨어요?>"
  },
  {
   "id": 3,
   "ko": "<그 검은 털가죽 놈들 목구멍에 빵이 걸려 숨이 막혀 버리기를.>"
  },
  {
   "id": 4,
   "ko": "<물건을 원하세요, 이야기를 원하세요?>"
  },
  {
   "id": 5,
   "ko": "<미안하지만 그건 도와드릴 수 없어요.>"
  },
  {
   "id": 6,
   "ko": "<물론이죠, 지금 물건이 좀 있어요. 둘러보세요.>"
  },
  {
   "id": 7,
   "ko": "<미안하지만 팔 게 없어요.>"
  },
  {
   "id": 8,
   "ko": "<뭘 사실 건가요, 아니면 그냥 얘기하러 들어오셨어요?>"
  },
  {
   "id": 9,
   "ko": "<뭘 사시려는 거죠? 아니면 수다나 떠실래요?>"
  },
  {
   "id": 10,
   "ko": "<늪에 들어갈 생각이라면 장비를 제대로 갖춰야 해요.>"
  },
  {
   "id": 11,
   "ko": "<늪으로 여행하려면 좋은 장비가 꼭 필요해요.>"
  },
  {
   "id": 12,
   "ko": "<사고 싶은 게 있으면 둘러보세요.>"
  },
  {
   "id": 13,
   "ko": "<그 이름은 기억이 안 나요, 미안해요.>"
  },
  {
   "id": 14,
   "ko": "<치료사가 왜 필요한지는 모르겠지만, 그 여자를 찾으려면 화려한 비상에서 물어보셔야 해요.>"
  },
  {
   "id": 15,
   "ko": "<그 이름은 들어 본 적 없어요.>"
  },
  {
   "id": 16,
   "ko": "<리치브론은 아이달 어딘가에 살아요. 하지만 골목 이름은 묻지 마세요.>"
  }
 ]
}