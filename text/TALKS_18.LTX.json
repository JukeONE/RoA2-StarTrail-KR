  {
   "id": 0,
   "ko": "<독에 대해 잘 아시오?>"
  },
  {
   "id": 1,
   "ko": "<제대로 독에 당했다면 마법에 운을 걸어 보는 게 좋을 거요.>"
  },
  {
   "id": 2,
   "ko": "<올긴 뿌리 - 그러면 며칠 동안은 안전하오.>"
  },
  {
   "id": 3,
   "ko": "<멘칼을 먹어 보시오. 좀 도움이 되오.>"
  },
  {
   "id": 4,
   "ko": "<사람을 죽이는 독도 있지만 그런 건 몇 안 되오. 물론 다쳐 있다면 얘기가 다르지만...>"
  },
  {
   "id": 5,
   "ko": "<아니, 그건 사람을 잘못 찾아왔소.>"
  },
  {
   "id": 6,
   "ko": "<신께 버림받은 연금술 잡탕들. 난 그런 거랑 엮이기 싫소.>"
  },
  {
   "id": 7,
   "ko": "<벨마르트는 몇몇 독에 꽤 잘 듣는 약이오.>"
  },
  {
   "id": 8,
   "ko": "<슈린 구근은 여러 칼날 독의 주재료요.>"
  }
 ]
