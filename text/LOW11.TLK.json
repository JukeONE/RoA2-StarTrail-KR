 "items": [
  {
   "id": 0,
   "ko": "알비니아 출리반"
  },
  {
   "id": 1,
   "ko": "<내가 보기엔 그 엘프들은 오크 포위를 아주 태연하게 받아들이고 있어요.>"
  },
  {
   "id": 2,
   "ko": "<사람을 잘못 찾으셨어요.>"
  },
  {
   "id": 3,
   "ko": "<더 중요한 얘기가 있다고 생각하지 않으세요?>"
  },
  {
   "id": 6,
   "ko": "<안스벨 - 설마 그 도마뱀 소굴에 정말 가겠다는 건 아니죠!>"
  },
  {
   "id": 7,
   "ko": "<스벨트 계곡에 대해 무슨 말을 하겠어요? 오크가 온 뒤로 예전 같은 건 하나도 없어요.>"
  },
  {
   "id": 8,
   "ko": "<스벨트 늪지는 위험해요 - 단단한 땅인 줄 알았는데 갑자기 늪 구덩이 한가운데 서 있는 경우가 많거든요.>"
  },
  {
   "id": 9,
   "ko": "<미안하지만 산은 잘 몰라요.>"
  },
  {
   "id": 10,
   "ko": "<들어 본 적 없어요.>"
  },
  {
   "id": 11,
   "ko": "<치료사는 길 건너편, 신전을 막 지나서 살아요.>"
  },
  {
   "id": 12,
   "ko": "<미안해요. 생각나는 게 없네요.>"
  },
  {
   "id": 13,
   "ko": "<그게 누군데요?>"
  }
 ]
}