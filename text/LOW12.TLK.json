 "items": [
  {
   "id": 0,
   "ko": "엘고르 온더"
  },
  {
   "id": 1,
   "ko": "<그 작은 사람들은 좀 투박하지만, 익숙해지면 정말 좋은 친구들이오.>"
  },
  {
   "id": 2,
   "ko": "<아, 그 얘긴 하지 마시오.>"
  },
  {
   "id": 5,
   "ko": "<남은 게 뭐가 있겠소?>"
  },
  {
   "id": 6,
   "ko": "<거긴 가지 마시오. 그 일대가 다 으스스하고 마법에 걸려 있소!>"
  },
  {
   "id": 7,
   "ko": "<거기 지리는 정말 모르오.>"
  },
  {
   "id": 8,
   "ko": "<누구?>"
  },
  {
   "id": 9,
   "ko": "<내가 알아야 하는 사람이오?>"
  },
  {
   "id": 10,
   "ko": "<빈다리아 리치브론 - 그렇게 착한 여자한테 참 끔찍한 이름이지. 외지에서 손님이 올 때마다 나한테서 방을 빌려 가오. 가쇼크 길에 살지 않나?>"
  }
 ]
}