{
 "file": "SEQUENCE.LTX",
 "kind": "ltx",
 "items": [
  {
   "id": 0,
   "ko": "<알다시피, 오크의 반란은 예전에도 한 번 진압되었소.>"
  },
  {
   "id": 1,
   "ko": "<하지만 그건 드워프와 엘프가 힘을 합쳤기에 가능했지.>"
  },
  {
   "id": 2,
   "ko": "<우정의 증표로 마법 유물이 하나>"
  },
  {
   "id": 3,
   "ko": "<바로 살라만더 돌이>"
  },
  {
   "id": 4,
   "ko": "<그 일을 기념해 만들어졌소.>"
  },
  {
   "id": 5,
   "ko": "<하지만 우정은 깨졌고>"
  },
  {
   "id": 6,
   "ko": "<살라만더 돌도 사라졌소.>"
  },
  {
   "id": 7,
   "ko": "<새로운 오크의 위협에 맞서려면>"
  },
  {
   "id": 8,
   "ko": "<살라만더 돌을 반드시 드워프 잉그라모쉬의 손에 전해야 하오!>"
  },
  {
   "id": 10,
   "ko": "<엘프를 만났지요? 사절인 척하는 엘프 말이오.>"
  },
  {
   "id": 11,
   "ko": "<엘프 사절 따위는 없다는 건 어린애도 아는 사실이오!>"
  },
  {
   "id": 12,
   "ko": "<그가 엘프와 드워프의 우정 이야기를 했소?>"
  },
  {
   "id": 13,
   "ko": "<말도 안 되는 소리! 그들은 물과 불처럼 함께할 수 없소!>"
  },
  {
   "id": 14,
   "ko": "<살라만더 돌은 아는 사람에게는 온갖 힘을 지닌 물건이오...>"
  },
  {
   "id": 15,
   "ko": "<...그리고 값어치도 엄청나지.@정말 엄청나오!>"
  },
  {
   "id": 16,
   "ko": "<그 돌에 무려 1000^두캇를 쳐 주겠소!>"
  },
  {
   "id": 17,
   "ko": "<그 돌을 로방엔의 빈다리아 리치브론에게 가져다준다면 말이오.>"
  },
  {
   "id": 20,
   "ko": "<놈들 방은 저 위다. 가라!>"
  },
  {
   "id": 21,
   "ko": "<여기가 틀림없어.>"
  },
  {
   "id": 22,
   "ko": "<어서, 놈들을 잡아!>"
  },
  {
   "id": 23,
   "ko": "<저기 있다 - 살인자들이다!>"
  },
  {
   "id": 24,
   "ko": "<죽여라!@저놈들은 그래도 싸다 - 죽여!>"
  },
  {
   "id": 25,
   "ko": "<멈춰라! 그들에게도 변론할 기회를 줘야 한다.>"
  },
  {
   "id": 26,
   "ko": "<너희는 우리 마을 시민을 살해한 혐의를 받고 있다.>"
  },
  {
   "id": 27,
   "ko": "<그들의 범행을 입증할 증거가 있습니다.>"
  },
  {
   "id": 28,
   "ko": "<잠깐, 이방인들에게 데레고른이 파문자들의 우두머리라는 증거가 있다.>"
  },
  {
   "id": 29,
   "ko": "<가도 좋다. 하지만 다시는 이 근처에 얼굴을 보이지 마라.>"
  },
  {
   "id": 30,
   "ko": "<멈춰라! 그 자리에 서!>"
  },
  {
   "id": 31,
   "ko": "<살라만더 돌을 내놔라, 안 그러면 죽인다!>"
  },
  {
   "id": 32,
   "ko": "<아무도 여길 지나갈 수 없다!@절대로!>"
  },
  {
   "id": 34,
   "ko": "<그 망할 돌덩이! 옜다, 가져가!>"
  },
  {
   "id": 35,
   "ko": "<너희 따위로는 우리를 겁줄 수 없다!>"
  },
  {
   "id": 36,
   "ko": "<말이 통할 줄 알았지.>"
  },
  {
   "id": 37,
   "ko": "<우르중가, 고란다, 바호르!>"
  },
  {
   "id": 38,
   "ko": "<잠깐, 이건 진짜 돌이 아니다.>"
  },
  {
   "id": 39,
   "ko": "<진짜는 아직 로방엔에 있는 게 틀림없어!>"
  },
  {
   "id": 40,
   "ko": "<이게 진짜가 아니라고? 기다려, 우리가 가져오겠다!>"
  },
  {
   "id": 45,
   "ko": "이름 없는 자의 추종자들이 살라만더 돌을 로방엔 밖으로 가져갔다."
  },
  {
   "id": 46,
   "ko": "이제 엘프와 드워프 사이에 우정은 있을 수 없다. 아르카니아가\n오크를 물리칠 희망은 모두 사라졌다."
  },
  {
   "id": 47,
   "ko": "잉그라모쉬가 죽었다!"
  },
  {
   "id": 48,
   "ko": "여러분이 가짜 살라만더 돌에 시간을 허비하는 동안, 이름 없는 자의\n추종자들이 진짜 돌을 로방엔 밖으로 가져갔다."
  }
 ]
}