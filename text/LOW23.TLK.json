 "items": [
  {
   "id": 0,
   "ko": "에슬람 아이더슈타인"
  },
  {
   "id": 1,
   "ko": "<내가 엘프 좋아하는 놈처럼 보여?!>"
  },
  {
   "id": 2,
   "ko": "<내 선술집에선 안 돼!>"
  },
  {
   "id": 3,
   "ko": "<오크 해골 하나 가져올 때마다 한 잔씩 공짜로 주지.>"
  },
  {
   "id": 4,
   "ko": "<마실 거야, 떠들 거야?>"
  },
  {
   "id": 5,
   "ko": "<모퉁이에 <꼬마 공작>이 있어.>"
  },
  {
   "id": 7,
   "ko": "<마시러 왔어, 수다 떨러 왔어?>"
  },
  {
   "id": 8,
   "ko": "<쓸 만한 무기를 구하려면 아이달 다리에 여자 무구 장인이 있고, 아니면 동쪽 성벽의 브롬코프 영감한테 등불이라도 갈아 달라고 해 봐.>"
  },
  {
   "id": 9,
   "ko": "<뭘로 할래: 마실래, 떠들래?>"
  },
  {
   "id": 10,
   "ko": "<술 마시러 왔어, 조언 들으러 왔어?>"
  },
  {
   "id": 11,
   "ko": "<그 오크 쓰레기들이 거기 빠져 죽기를!>"
  },
  {
   "id": 12,
   "ko": "<뭘 하고 싶어: 마실래, 혀나 놀릴래?>"
  },
  {
   "id": 13,
   "ko": "<오, 더 고급 술집을 원하시나 보지?!>"
  },
  {
   "id": 14,
   "ko": "<그놈 머리라면 관심 있지. 되도록 몸에서 떨어진 걸로!>"
  },
  {
   "id": 15,
   "ko": "<치료사는 뭐 하러 찾아? 물, 침, 그리고 약간의 배짱이면 충분해!>"
  },
  {
   "id": 16,
   "ko": "<지금 날 엘프 좋아하는 놈이라고 부르는 거야?!>"
  },
  {
   "id": 17,
   "ko": "<들어 본 적 없어요.>"
  },
  {
   "id": 18,
   "ko": "<그래, 알지 - 가끔 들르거든.>"
  }
 ]
}