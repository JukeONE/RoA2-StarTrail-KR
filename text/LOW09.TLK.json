{
 "file": "LOW09.TLK",
 "kind": "script",
 "items": [
  {
   "id": 0,
   "ko": "데미온 바스크"
  },
  {
   "id": 1,
   "ko": "<화려한 비상에서 물어보는 게 좋겠소.>"
  },
  {
   "id": 2,
   "ko": "<아이달에서 물어보시오.>"
  },
  {
   "id": 3,
   "ko": "<그 검은 털가죽 놈들은 끔찍하고 느리고 고통스럽게 죽어 마땅하오. 한 놈도 빠짐없이!>"
  },
  {
   "id": 4,
   "ko": "<이봐요, 요즘 머리가 복잡해서...>"
  },
  {
   "id": 7,
   "ko": "<로방엔엔 나그네가 없소. 마을을 어떻게 빠져나가겠소?!"
  },
  {
   "id": 8,
   "ko": "<이봐요, 지금도 손이 모자라서...>"
  },
  {
   "id": 9,
   "ko": "<음, 어, 지금 정말 바쁜 때라서...>"
  },
  {
   "id": 10,
   "ko": "<있잖소, 지금 할 일이 산더미라서...>"
  },
  {
   "id": 11,
   "ko": "<이봐요, 남아서 얘기하기 싫은 건 아닌데...>"
  },
  {
   "id": 12,
   "ko": "<솔직히 지금 일이 너무 많아서...>"
  },
  {
   "id": 13,
   "ko": "<더 떠들고 싶지 않은 건 아니지만...>"
  },
  {
   "id": 14,
   "ko": "<그런 이름은 모르오.>"
  },
  {
   "id": 15,
   "ko": "<그 여자는 치료사요, 스타트레일 부인. 솜씨도 좋지. 집은 차 신전 근처에 있소.>"
  },
  {
   "id": 16,
   "ko": "<그런 이름은 기억나지 않소.>"
  },
  {
   "id": 17,
   "ko": "<그 친구는 모르오.>"
  }
 ]
}