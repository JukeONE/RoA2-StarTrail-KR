{
 "file": "LOW26.TLK",
 "kind": "script",
 "items": [
  {
   "id": 0,
   "ko": "헬라 스카르펜베르크"
  },
  {
   "id": 1,
   "ko": "<스벨트 계곡엔 드워프가 꽤 많아요. 로방엔뿐 아니라 다른 마을과 촌락에도요."
  },
  {
   "id": 2,
   "ko": "<얻어맞고 싶으면 얼마든지 오라고 해요!>"
  },
  {
   "id": 3,
   "ko": "<지금은 날씨 따위 전혀 신경 안 써요.>"
  },
  {
   "id": 4,
   "ko": "<<위대한 자유>에 방이 없으면 여관 바로 뒤 <검은 얀도라>에 가 보세요.>"
  },
  {
   "id": 6,
   "ko": "<필경사를 찾는다면 빈살터에게 가 보세요.>"
  },
  {
   "id": 7,
   "ko": "<세상에, 그걸 나한테 물어본 건 당신들이 처음이에요.>"
  },
  {
   "id": 8,
   "ko": "<그건 제가 겪어 본 일이 아니라서요.>"
  },
  {
   "id": 9,
   "ko": "<미안해요, 가 본 적 없어요.>"
  },
  {
   "id": 10,
   "ko": "<어머! 제 보잘것없는 가게가 마음에 안 든다면 - 나가셔도 돼요.>"
  },
  {
   "id": 11,
   "ko": "<모르는 사람이에요.>"
  },
  {
   "id": 12,
   "ko": "<그 이름이 뭐였죠? 처음 들어요.>"
  },
  {
   "id": 13,
   "ko": "<들어 본 이름은 아니네요.>"
  },
  {
   "id": 14,
   "ko": "그 노인의 진짜 이름은 저도 몰라요 - 다들 그냥 빈살터라고 불러요. 스벨트예 골짜기, 그 작은 공원 바로 옆에 살아요.>"
  }
 ]
}