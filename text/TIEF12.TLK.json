{
 "file": "TIEF12.TLK",
 "kind": "script",
 "items": [
  {
   "id": 0,
   "ko": "오리 리펜스"
  },
  {
   "id": 1,
   "ko": "<어이쿠, 친구들. 뭘로 할 텐가?>"
  },
  {
   "id": 2,
   "ko": "<가 봐야겠네. 많이들 들게, 젊은이들, 아가씨들!>"
  },
  {
   "id": 3,
   "ko": "<땅바닥에 비하면 키가 좀 크지.>"
  },
  {
   "id": 4,
   "ko": "<살라만더 돌 산맥에 숨어 산다네.>"
  },
  {
   "id": 5,
   "ko": "<엘프 머릿속에선 참 이상한 일이 벌어진다니까.>"
  },
  {
   "id": 6,
   "ko": "<궁금하지, 응?>"
  },
  {
   "id": 7,
   "ko": "<땅바닥에 비하면 키가 좀 작지만, 쇠붙이 다루는 솜씨는 대단하다더군.>"
  },
  {
   "id": 8,
   "ko": "<이봐 - 머리에 열 오르는데 자꾸 묻고 또 묻는구먼!>"
  },
  {
   "id": 9,
   "ko": "<그 녀석들 힘 하난 장사야. 이오만 경기를 하면 끝내줄 텐데. 물론 아무도 자리를 안 주지만.>"
  },
  {
   "id": 10,
   "ko": "<귀먹었나, 응?>"
  },
  {
   "id": 12,
   "ko": "<아하 - 보물 사냥꾼들이로군, 응?>"
  },
  {
   "id": 13,
   "ko": "<이 촌구석엔 아무 일도 없어! 여기서 뭘 바라나?>"
  },
  {
   "id": 14,
   "ko": "<아직 성에 안 찼나, 응?>"
  },
  {
   "id": 15,
   "ko": "<전혀 모르겠는데.>"
  }
 ]
}