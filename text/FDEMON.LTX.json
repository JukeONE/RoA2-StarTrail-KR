 "items": [
  {
   "id": 0,
   "ko": "<감히 내 탑에 들어오다니?>"
  },
  {
   "id": 1,
   "ko": "<사브리나가 보낸 게로군.@그 여자는 늘 내 수정 구슬을 탐냈지.>"
  },
  {
   "id": 2,
   "ko": "<하지만 내 힘을 견딜 자를 너희에게서 찾았다고 생각한다면 큰 오산이다!>"
  },
  {
   "id": 3,
   "ko": "<공포라는 말이 무슨 뜻인지 가르쳐 줄 조수를 불러내 주마.>"
  },
  {
   "id": 4,
   "ko": "<통제를 벗어난다... 안 돼...!@프라이오스여, 도와주소서!!!>"
  },
  {
   "id": 5,
   "ko": "<침입자들에게 파멸을!>"
  },
  {
   "id": 6,
   "ko": "<헤진데의 적들에게 죽음을.@너는 그분의 사자이자 나의 종이다!>"
  },
  {
   "id": 7,
   "ko": "<저 쓰레기들을 없애 버려라!>"
  },
  {
   "id": 8,
   "ko": "<누가 감히 나를 내 차원에서 끌어내 헤진데를 섬기는 일을 방해하느냐?>"
  },
  {
   "id": 9,
   "ko": "<여기엔 쓸 만한 자가 하나도 안 보이는구나.>"
  },
  {
   "id": 10,
   "ko": "<그렇다면 알맞은 겸손으로 간청하라. 여기 누군가는 내 신성한 분노의 표적이 될 것이니.>"
  },
  {
   "id": 11,
   "ko": "<잘 받아쳤다, 작은 자여.>"
  },
  {
   "id": 12,
   "ko": "<하나같이 갈수록 가관이구나.>"
  },
  {
   "id": 13,
   "ko": "<말을 아주 잘 아는 듯이 고르는구나!>"
  },
  {
   "id": 14,
   "ko": "<저 노인이 너희보다 생각하며 말하는 것 같구나.>"
  },
  {
   "id": 15,
   "ko": "<부르는 게 다가 아니다!@다스리는 것이 힘이다!@같은 실수를 두 번 하는 자는 없다!>"
  },
  {
   "id": 16,
   "ko": "<이번엔 너희 뜻대로 해 주마. 하지만 감히 두 번 다시 나를 부르지 마라.>"
  },
  {
   "id": 17,
   "ko": "불의 정령에게 뭐라고 대답하겠습니까?"
  },
