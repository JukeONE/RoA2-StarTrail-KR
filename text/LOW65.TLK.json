   "id": 0,
   "ko": "브린 바스켄단츠"
  },
  {
   "id": 1,
   "ko": "금발의 껑충한 남자가 문을 열고 여러분을 위아래로 훑어봅니다."
  },
  {
   "id": 2,
   "ko": "<들어 보시오 - 난 엘프, 드워프, 인간 사이의 다툼에는 끼지 않소.>"
  },
  {
   "id": 3,
   "ko": "<말해 두지만 - 난 드워프, 엘프, 인간 사이의 다툼에는 끼지 않소.>"
  },
  {
   "id": 4,
   "ko": "<제일 크게 불평하는 놈들 대부분이 뒤에선 손을 비비고 있소 - 이 포위 덕에 장사가 아주 잘되거든.>"
  },
  {
   "id": 5,
   "ko": "<내가 장사꾼 아낙처럼 보이오?!>"
  },
  {
   "id": 7,
   "ko": "<씹을 거리가 필요하면 남쪽 구역의 라이샤한테 가 보시오. 하지만 싸진 않을 거요, 그건 장담하지!>"
  },
  {
   "id": 8,
   "ko": "<난 그런 일엔 엮이기 싫소!>"
  },
  {
   "id": 9,
   "ko": "<모르는 남자요.>"
  },
  {
   "id": 10,
   "ko": "<들어 본 적 없어.>"
  },
  {
   "id": 11,
   "ko": "<모르는 여자요.>"
  },
  {
   "id": 12,
   "ko": "<리치 뭐? 아니.>"
  },
  {
   "id": 13,
   "ko": "<아니, 정말이오. 나한테 원하는 게 뭐요?>"
  }
 ]
